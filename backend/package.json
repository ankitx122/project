{
  "name": "osint-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API for the IP Intelligence frontend: IP/CIDR/range lookups, Google sign-in and user profiles",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db": "node --env-file-if-exists=.env scripts/dev-db.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17"
  }
}
