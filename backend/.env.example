# Copy to .env and fill in.

PORT=4000
# Public URL of this API. Google redirects to ${BACKEND_URL}/auth/google/callback.
BACKEND_URL=http://localhost:4000
# The Next.js frontend (CORS origin and where users land after signing in).
FRONTEND_URL=http://localhost:3000

# Any PostgreSQL works. `npm run db` starts a local one matching this URL.
DATABASE_URL=postgres://osint:osint@localhost:5433/osint

# Google sign-in uses the project's shared OAuth client. The client ID is public.
# The secret is NOT kept in git: ask the project owner for it and paste it here.
GOOGLE_CLIENT_ID=153056770104-onmrmlb6gej042uhga1tto6dv2c703el.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Lookup data sources (required; the API won't start without them).
# ip-api.com (geolocation / ASN). Free: http://ip-api.com (non-commercial, rate limited).
# With a Pro key use https://pro.ip-api.com and set IP_API_KEY.
IP_API_URL=http://ip-api.com
IP_API_KEY=
# RIPEstat (BGP prefixes / origin ASNs) and the app name sent with each request.
RIPESTAT_URL=https://stat.ripe.net/data
RIPESTAT_SOURCEAPP=osint-lookup
# RDAP / WHOIS registration data (owner, abuse contact, allocation dates). rdap.org forwards
# each query to the registry that holds it (ARIN, RIPE NCC, APNIC, LACNIC, AFRINIC).
RDAP_URL=https://rdap.org
# Per-request timeout, and how long lookup results are cached in memory.
LOOKUP_TIMEOUT_MS=15000
LOOKUP_CACHE_TTL_SECONDS=3600

# Optional: session length, and "none" if the frontend and API are on different sites (needs HTTPS).
SESSION_DAYS=30
COOKIE_SAMESITE=lax
